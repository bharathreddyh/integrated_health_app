rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /models/{allPaths=**} {
      // Only Firebase-authenticated users can read (anonymous auth included).
      // This blocks all browser/curl access without the app's Firebase session.
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Block everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
