rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /models/{allPaths=**} {
      // Public read — models are not sensitive and need to work on all devices
      // without App Check (Play Integrity) setup. Writes are fully locked.
      allow read: if true;
      allow write: if false;
    }
    // Block everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
